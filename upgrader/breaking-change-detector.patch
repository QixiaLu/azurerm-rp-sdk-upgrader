+// Copyright IBM Corp. 2014, 2025
+// SPDX-License-Identifier: MPL-2.0
+
+package acceptance
+
+import (
+	"regexp"
+	"testing"
+
+	"github.com/hashicorp/terraform-plugin-testing/helper/resource"
+)
+
+func TestModifyTestCaseUsesLastApplicableConfigForCleanup(t *testing.T) {
+	t.Setenv("TF_ACC_PROVIDER_VERSION", "5.6.0")
+
+	const (
+		baseConfig           = "base configuration"
+		requiresImportConfig = "configuration with duplicate resource"
+	)
+	testCase := &resource.TestCase{
+		Steps: []resource.TestStep{
+			{Config: baseConfig},
+			{
+				Config:      requiresImportConfig,
+				ExpectError: regexp.MustCompile("requires import"),
+			},
+		},
+	}
+	testData := TestData{ResourceName: "azurerm_example.test"}
+
+	testData.modifyTestCase(testCase)
+
+	if got, want := len(testCase.Steps), 4; got != want {
+		t.Fatalf("got %d steps, want %d", got, want)
+	}
+	if got := testCase.Steps[2].Config; got != requiresImportConfig {
+		t.Fatalf("expected-error step config = %q, want %q", got, requiresImportConfig)
+	}
+	if got := testCase.Steps[3].Config; got != baseConfig {
+		t.Errorf("cleanup config = %q, want last applicable config %q", got, baseConfig)
+	}
+	if testCase.Steps[3].ExpectError != nil {
+		t.Errorf("cleanup step unexpectedly retains expected error %q",
+			testCase.Steps[3].ExpectError)
+	}
+}
