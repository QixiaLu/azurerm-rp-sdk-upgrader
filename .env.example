# Copy to `.env` and fill in your values, then pass it with `--env-file .env`
# (docker compose loads it automatically). Do NOT commit the real `.env`.

# ---------------------------------------------------------------------------
# Copilot auth (REQUIRED for every run) — a GitHub token with Copilot access.
# ---------------------------------------------------------------------------
GH_TOKEN=

# ---------------------------------------------------------------------------
# Azure credentials (REQUIRED for acctest runs; omit if you use --skip-acctest).
# The acctest stage creates REAL Azure resources with these — use a test sub.
# ---------------------------------------------------------------------------
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_SUBSCRIPTION_ID=
ARM_TENANT_ID=
ARM_TEST_LOCATION=eastus
ARM_TEST_LOCATION_ALT=northeurope
ARM_TEST_LOCATION_ALT2=francecentral

# ---------------------------------------------------------------------------
# TeamCity baseline (OPTIONAL; acctest only). Without a token the acctest stage
# runs in degraded mode (empty `main` baseline — every failure looks NEW).
# ---------------------------------------------------------------------------
TEAMCITY_TOKEN=
# Override only if you use a non-default TeamCity server.
# TEAMCITY_SERVER_URL=https://hashicorp.teamcity.com
